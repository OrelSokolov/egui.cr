# egui.cr build configuration (compile-time; copy to .env to use).
#
# C accelerators for DEV builds (--release never uses them, and they
# are OFF by default — a fresh clone builds a self-contained
# pure-Crystal UI with no libfreetype/C shims):
#   * fonts: system libfreetype via C FFI (backend/freetype.cr)
#   * SVG:   the C NanoSVG shim (backend/nanosvg.cr)
# Output is byte-identical to the pure-Crystal paths, so dev and
# release render the same; this only speeds up the bake under debug
# codegen. Requires libfreetype on the system (crosspack: freetype-dev).
#
#USE_C_EXTENSIONS=1
#
# Lottie (rlottie) feature flag — for the BUILD (Rakefile), not the
# compiler: with it the rlottie shim + CMake-built librlottie.a are
# archived (libegui_cr_rlottie + lib/rlottie), the `lottie` example
# joins EXAMPLES and the link line gains lib/rlottie + libc++/
# libstdc++. OFF by default: a normal build has no cmake/C++
# dependency. One-time vendor + build:
#   rake download:rlottie
#   LOTTIE=1 rake build:native
# Apps opt in at compile time with: require "egui/backend/rlottie"
#
#LOTTIE=1

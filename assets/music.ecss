/* music.ecss — геометрия демо Raven Music (порт oracle/raven_music/
   style.css). Правила читает кастомный тег <panel class="…">:
   padding / rounding / stroke-width / transition.
   Цвета (background/stroke/hover) сюда НЕ входят: их пишет приложение
   поверх сессии по текущему луку (MusicExmlApp#apply_look — аналог
   <Theme>-файлов Raven: одна разметка, разные темы). */

center {
  stroke-width: 1;
  rounding: 12;
}

nowplaying {
  stroke-width: 1;
  rounding: 12;
  padding: 16;
}

nav-box {
  stroke-width: 1;
  rounding: 12;
  padding.top: 10;
  padding.right: 8;
  padding.bottom: 10;
  padding.left: 8;
}

lib-box {
  stroke-width: 1;
  rounding: 12;
  padding: 10;
}

center-page {
  padding.top: 20;
  padding.right: 24;
  padding.bottom: 32;
  padding.left: 24;
}

col-page { }

album-card {
  rounding: 10;
  padding: 10;
}

quick {
  rounding: 6;
  transition.background: 150;
}

np-artist-card {
  rounding: 10;
  padding: 16;
}

np-queue-card {
  rounding: 10;
  padding: 14;
}

about-card {
  rounding: 10;
  padding: 18;
}

lib-row {
  padding: 4;
  transition.background: 120;
}

lib-cards { }

track-row {
  transition.background: 120;
}

/* ios_settings.ecss — iOS-лук «Настроек» (порт apply_ios_theme из
   examples/ios_settings.cr). Ключи — движковые (подчёркивания, как в
   StyleVars: парсер ecss дефисы не нормализует). */

switch {
  on_color: #34C759;
  off_color: #E9E9EA;
  thumb_color: #FFFFFF;
  track_width: 51;
  tumbler_size: 31;
}

card {
  background: #FFFFFF;
  rounding: 10;
  padding: 0;
}

search_bar {
  background: #E9E9EB;
  padding.left: 14;
  padding.right: 32;
}

slider {
  fill: #007AFF;
  selection_fill: #007AFF;
  width: 220;
}

segmented {
  background: #EAEAEA;
  stroke_width: 0;
  rounding: 9;
  selection_fill: #FFFFFF;
  selection_text: #000000;
  text_color: #000000;
  font_size: 13;
  width: 100%;
  height: 32;
  shadow.color: #00000040;
  shadow.blur: 2;
  shadow.y: 2;
}

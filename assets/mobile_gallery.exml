<!-- Mobile gallery — the mobile widget catalog as EXML markup
     (examples/mobile_gallery_exml.cr drives it; the vocabulary lives
     in src/egui/exml_mobile.cr — `require "egui/exml_mobile"`). -->
<page id="root/root">
  <screen>
    <app-bar title="Mobile gallery" back="true" on_back="go_back">
      <appbar-action icon="copy" on_click="open_sheet"/>
    </app-bar>

    <screen-body>
      <!-- Tab 0: Controls -->
      <card id="quick_settings" if="tab0">
        <heading text="Quick settings"/>
        <list-tile title="Wi-Fi" subtitle="{wifi_sub}" leading_icon="wifi"
                   id="row_wifi">
          <switch bind="wifi"/>
        </list-tile>
        <list-tile title="Do not disturb" leading_icon="close" id="row_dnd">
          <switch bind="dnd"/>
        </list-tile>
      </card>
      <row if="tab0">
        <label text="Volume"/>
        <stepper bind="volume" min="0" max="10" step="1" id="step_vol"/>
      </row>
      <label text="Filters" if="tab0"/>
      <chip-row on_close="chip_closed" if="tab0">
        <chip label="Wi-Fi 6" icon="wifi" bind="sel_c1"/>
        <chip label="Bluetooth" icon="bluetooth" bind="sel_c2"/>
        <chip label="Roaming" bind="sel_c3"/>
        <chip label="Guest net" closable="true" bind="sel_c4"/>
      </chip-row>
      <label text="Rate this build" if="tab0"/>
      <rating-bar bind="rating" count="5" step="0.5" id="rating" if="tab0"/>
      <label text="Price range: {price_lo_s} — {price_hi_s} ₽" if="tab0"/>
      <range-slider bind_lo="price_lo" bind_hi="price_hi"
                    min="0" max="100" id="price" if="tab0"/>

      <!-- Tab 1: Lists -->
      <search-bar bind="query" hint="Search contacts" id="search" if="tab1"/>
      <swipe-item id="swipe_row" on_dismiss="row_deleted" if="tab1">
        <swipe-action label="Delete" color="#dc3c3c"/>
        <list-tile title="Alex Chen" subtitle="swipe me left"
                   leading_icon="bluetooth" id="row_swipe"/>
      </swipe-item>
      <row if="tab1">
        <avatar name="Maria Ivanova" size="40" id="avatar0"/>
        <badge count="1"/>
        <list-tile title="Maria Ivanova" subtitle="online" id="row0"/>
      </row>
      <row if="tab1">
        <avatar name="John Okafor" size="40" id="avatar1"/>
        <badge count="2"/>
        <list-tile title="John Okafor" subtitle="last seen 2h ago" id="row1"/>
      </row>
      <row if="tab1">
        <avatar name="Yuki Tanaka" size="40" id="avatar2"/>
        <list-tile title="Yuki Tanaka" subtitle="last seen 2h ago" id="row2"/>
      </row>

      <!-- Tab 2: Sheets -->
      <column if="tab2">
        <button text="Show AlertDialog" on_click="show_dialog"/>
        <label text="last: {last_result}"/>
        <button text="Open bottom sheet" on_click="open_sheet"/>
        <separator/>
        <label text="Pull the strip below (simulated)"/>
        <pull-to-refresh bind="spin" label="Refreshing…" id="ptr"/>
        <button text="Start refresh" on_click="start_refresh"/>
        <separator/>
        <pager pages="3" bind="page" height="120" id="pager">
          <label text="page {_i} — swipe horizontally"/>
        </pager>
        <page-indicator count="3" bind="page" id="dots"/>
      </column>

      <!-- Tab 3: Extras -->
      <column if="tab3">
        <label text="Enter the code"/>
        <pin-input bind="code" count="4" id="pin" on_filled="code_done"/>
        <row>
          <circular-progress value="0.42" text="42%" id="cp"/>
          <label text="  download"/>
        </row>
        <label text="Skeleton (loading list)"/>
        <skeleton rows="3" id="skel"/>
        <safe-area top="8" bottom="8" left="12" right="12" id="safe_demo">
          <label text="↳ padded by SafeArea (insets from a future device port)"/>
        </safe-area>
      </column>
    </screen-body>

    <bottom-nav bind="tab">
      <nav-item icon="check" label="Controls"/>
      <nav-item icon="copy" label="Lists"/>
      <nav-item icon="up" label="Sheets"/>
      <nav-item icon="monitor" label="Extras"/>
    </bottom-nav>

    <fab icon="plus" margin_bottom="104" on_click="new_item"/>
    <snackbar text="{snack_text}" action_text="{snack_action}"
              visible="{snack_on}" lift="88" id="gallery_toast"
              on_action="snack_clear"/>
  </screen>
</page>

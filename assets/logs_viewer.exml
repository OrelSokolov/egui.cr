<exml>
  <!-- LogsViewer — the chrome for examples/logs_viewer.cr: the file
       row, the level chips (<levels_bar/>, a custom element the app
       renders from its JSON config), the regex field and the stats
       lines are markup; <log_list/> is the app's visible-band list.
       Edit this file while the app runs — it hot-reloads. -->

  <!-- <menubar> sits directly under <page> (ctx.menu_bar — the
       desktop menu strip under the title bar, dropdowns included),
       never inside the content column: nested there it degrades to
       plain rows. -->
  <page id="root/root">
    <menubar>
      <menu label="File">
        <item label="Open…" on_click="open" hint="Ctrl+O"/>
      </menu>
      <menu label="Settings">
        <item label="{bench_mark}Show benchmark" on_click="toggle_bench"/>
      </menu>
    </menubar>
    <!-- <central> goes through ctx.central_panel — deferred and
         flushed INSIDE the page, so it lands BELOW the menu bar (a
         bare column renders inline into the page Ui that spans the
         whole window — that was the overlap). -->
    <central>
      <column>
      <row>
        <label text="{file_label}"/>
      </row>
      <levels_bar/>
      <input bind="regex" hint="regex filter — ANDed with the levels" on_change="regex_changed"/>
      <row if="show_bench">
        <label text="{stats}"/>
      </row>
      <row>
        <label text="{status}"/>
        <label text="{fps}" if="show_bench"/>
      </row>
      <separator/>
      <log_list/>
      </column>
    </central>
  </page>
</exml>
